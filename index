</style></head><body><div class="shell"><div class="top"><div class="brand">⚽ MATCHLAB <small>2D FOOTBALL SIMULATION ENGINE · P03</small></div><div class="badge">LOCAL BROWSER PROTOTYPE · NO INSTALLATION</div></div><div class="layout"><aside class="panel"><h2>Team configuration</h2><div class="teamswitch"><button id="team0" class="chosen">HOME</button><button id="team1">AWAY</button></div><div class="controls"><div><label>Formation</label><select id="formation"></select></div><div><label>Playing style</label><select id="style"><option value="balanced">Balanced</option><option value="possession">Possession</option><option value="direct">Direct</option><option value="counter">Counterattack</option></select></div><div><label>Pressing</label><select id="press"><option value="low">Low</option><option value="medium" selected>Medium</option><option value="high">High</option></select></div><div><label>Mentality</label><select id="mentality"><option value="defensive">Defensive</option><option value="balanced" selected>Balanced</option><option value="attacking">Attacking</option></select></div></div><h3>Starting XI <span class="tiny">· click player to edit</span></h3><div id="squad" class="squad"></div><h3>Substitutions <span id="subsUsed" class="tiny"></span></h3><div class="subselects"><select id="outPlayer"></select><select id="inPlayer"></select></div><button id="subBtn" style="width:100%;margin-top:7px">Make substitution</button><p class="hint">17 players per team: 11 starters and 6 substitutes. Up to 5 substitutions, with a simplified limit (no substitution windows).</p></aside><main class="panel"><div class="scorebar"><div class="teamlabel" style="color:var(--blue)">BLUE XI<div class="subline" id="homeFormation">4-3-3</div></div><div style="text-align:center"><div class="score" id="score">0 : 0</div><div class="subline" id="clock">00:00 · FIRST HALF</div></div><div class="teamlabel" style="color:var(--orange)">ORANGE XI<div class="subline" id="awayFormation">4-4-2</div></div></div><div class="pitchwrap"><canvas id="pitch" width="1050" height="680"></canvas></div><div class="toolbar"><button id="start" class="primary">▶ Play</button><button id="step">Step 10 s</button><button id="reset">↺ Reset</button><select id="speed" aria-label="Simulation speed"><option value="1">1× speed</option><option value="2">2× speed</option><option value="5" selected>5× speed</option><option value="15">15× speed</option><option value="45">45× speed</option><option value="120">120× speed</option></select><label style="margin:auto 0 auto auto">Seed <input id="seed" type="number" value="2027" min="1" max="999999999" style="width:96px"></label></div><div class="metrics"><div class="metric"><b id="poss">50% : 50%</b><span>Possession</span></div><div class="metric"><b id="shots">0 : 0</b><span>Shots</span></div><div class="metric"><b id="sot">0 : 0</b><span>On target</span></div><div class="metric"><b id="xg">0.00 : 0.00</b><span>xG (model)</span></div></div><h2>Match commentary</h2><div id="log" class="eventlog"></div></main><section class="right"><div class="panel"><div class="tabrow"><button id="tabPlayer" class="sel">PLAYER EDITOR</button><button id="tabTests">ENGINE TESTS</button></div><div id="editor"><h2 id="playerName">Player attributes</h2><p id="playerInfo" class="hint"></p><div id="attributes" class="attrgrid"></div><button id="randomize" style="width:100%;margin-top:14px">Randomise selected player</button><p class="hint">Ratings 1–99. Every action uses the relevant player attributes, opponent pressure, position, fatigue and a seeded random draw. Editing during play affects subsequent actions.</p></div><div id="testsPanel" class="hidden"><h2>Monte Carlo comparison</h2><p class="hint">Run complete simulated matches without animation. A fixed seed sequence makes before/after comparisons reproducible. This is a simplified diagnostic model, not calibrated match data.</p><label>Number of matches</label><select id="batchCount"><option value="50">50</option><option value="200" selected>200</option><option value="1000">1,000</option></select><button id="batchRun" class="primary" style="width:100%;margin:9px 0">Run batch test</button><div id="batchResults" class="tests"></div><h3>Sanity checks</h3><div id="sanity" class="tests"></div></div></div><div class="panel"><h2>Engine diagnostics</h2><table><tr><td>Match phase</td><td id="phase">Pre-match</td></tr><tr><td>Ball carrier</td><td id="carrier">—</td></tr><tr><td>Current possession</td><td id="owner">—</td></tr><tr><td>Events simulated</td><td id="events">0</td></tr><tr><td>Passes completed</td><td id="passes">0 : 0</td></tr><tr><td>Turnovers</td><td id="turnovers">0 : 0</td></tr><tr><td>Fitness (average)</td><td id="fitness">100% : 100%</td></tr></table><h3>Model scope</h3><p class="hint">High-frequency off-ball movement with frame-interpolated 2D player positioning with discrete pass, dribble, interception, tackle and shot decisions. Ball trajectory is animated. Relative positions affect passing lanes, defending and opportunities. Formations influence spacing in and out of possession.</p><p class="hint">Currently simplified: ball physics, officiating, restarts, aerial challenges, injuries, cards and offside. The simulation intentionally prioritises testable player interactions.</p></div></section></div></div><script>
'use strict';
const W=105,L=68,STEP=0.05,formations={"4-3-3":[4,3,3],"4-4-2":[4,4,2],"4-2-3-1":[4,2,3,1],"3-5-2":[3,5,2],"5-3-2":[5,3,2],"4-1-4-1":[4,1,4,1],"3-4-3":[3,4,3]};
const attrNames=['Pace','Acceleration','Stamina','Passing','Vision','First touch','Dribbling','Finishing','Long shots','Tackling','Marking','Positioning','Strength','Decisions','Composure','Goalkeeping'];const keys=['pace','acceleration','stamina','passing','vision','touch','dribbling','finishing','longshots','tackling','marking','positioning','strength','decisions','composure','goalkeeping'];
const $=id=>document.getElementById(id);const clamp=(x,a,b)=>Math.max(a,Math.min(b,x));const dist=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y);const avg=(xs)=>xs.reduce((a,b)=>a+b,0)/Math.max(1,xs.length);
function seeded(s){let x=(Number(s)>>>0)||1;return()=>{x+=0x6D2B79F5;let t=x;t=Math.imul(t^(t>>>15),t|1);t^=t+Math.imul(t^(t>>>7),t|61);return ((t^(t>>>14))>>>0)/4294967296}};
function mkPlayer(team,i,rng){let roles=['GK','RB','CB','CB','LB','DM','CM','CM','RW','ST','LW','AM','CB','CM','FB','WG','ST'];let role=roles[i],p={id:team*17+i,team,name:(team?'Orange ':'Blue ')+['Keeper','Mercer','Stone','Reed','Vale','Mason','Carter','Parker','Hayes','Taylor','Bennett','Brooks','Hunter','Cole','Wood','Adams','Wells'][i],num:i+1,role,active:i<11,fitness:1,x:0,y:0,tx:0,ty:0};keys.forEach(k=>p[k]=clamp(Math.round(63+rng()*22+(role==='GK'&&k==='goalkeeping'?13:0)-(role==='GK'&&['finishing','dribbling','tackling'].includes(k)?18:0)),1,99));if(role!=='GK')p.goalkeeping=clamp(Math.round(8+rng()*17),1,99);if(role==='ST'||role==='WG'||role==='RW'||role==='LW'){p.finishing=clamp(p.finishing+8,1,99);p.pace=clamp(p.pace+5,1,99)}if(['CB','RB','LB','FB'].includes(role)){p.tackling=clamp(p.tackling+9,1,99);p.marking=clamp(p.marking+7,1,99)}return p}
function makeTeams(){let rng=seeded(4599);return [0,1].map(t=>({formation:t?'4-4-2':'4-3-3',style:'balanced',press:'medium',mentality:'balanced',subCount:0,players:Array.from({length:17},(_,i)=>mkPlayer(t,i,rng))}))}
let teams=makeTeams(),selectedTeam=0,selectedId=0,sim=null,playing=false,accum=0,lastFrame=performance.now(),ballFx=null;
// Rendering coordinates are independent of authoritative simulation coordinates.
const visualPlayers=new Map();let visualBall={x:52.5,y:34};let lastVisualOwner=null;
function resetVisuals(){visualPlayers.clear();for(const t of teams)for(const p of t.players)visualPlayers.set(p.id,{x:p.x,y:p.y});visualBall={x:sim?.ball.x??52.5,y:sim?.ball.y??34};lastVisualOwner=sim?.carrier?.id??null;ballFx=null}
function smoothVisuals(dt){if(!sim)return;const speed=Number($('speed').value)||1;
  // Smaller simulation steps yield continuous off-ball targets; per-frame damping removes residual stepping.
  const a=1-Math.exp(-dt*7),playerMax=(8+speed*6.2)*dt;
  for(const t of teams)for(const p of t.players){let v=visualPlayers.get(p.id);if(!v){v={x:p.x,y:p.y};visualPlayers.set(p.id,v)}
    const dx=p.x-v.x,dy=p.y-v.y,d=Math.hypot(dx,dy);if(d>.0001){let step=Math.min(d*a,playerMax,d);v.x+=dx/d*step;v.y+=dy/d*step}}
  let target=sim.ball;const carrier=sim.carrier;
  // Put the ball just ahead of the carrier so it remains visibly distinct.
  if(carrier){const cp=visualPlayers.get(carrier.id);if(cp){let vx=carrier.x-cp.x,vy=carrier.y-cp.y,n=Math.hypot(vx,vy);let forward=carrier.team?-1:1;target={x:cp.x+(n>.2?vx/n*.95:forward*1.6),y:cp.y+(n>.2?vy/n*.95:0.55)};}}
  if(ballFx){const u=Math.min(1,(performance.now()-ballFx.at)/ballFx.duration);const ease=u*u*(3-2*u);
    visualBall.x=ballFx.a.x+(ballFx.b.x-ballFx.a.x)*ease;visualBall.y=ballFx.a.y+(ballFx.b.y-ballFx.a.y)*ease;
    if(u>=1)ballFx=null;
  }else{const b=1-Math.exp(-dt*15);visualBall.x+=(target.x-visualBall.x)*b;visualBall.y+=(target.y-visualBall.y)*b;}
  visualBall.x=clamp(visualBall.x,0,105);visualBall.y=clamp(visualBall.y,0,68);lastVisualOwner=carrier?.id??null;
}
function active(t){return teams[t].players.filter(p=>p.active)}function overall(p){let relevant=p.role==='GK'?['goalkeeping','positioning','composure','decisions']:['passing','touch','positioning','decisions','pace','stamina',...(p.role==='ST'?['finishing','finishing']:['tackling'])];return Math.round(avg(relevant.map(k=>p[k])))}
function template(team){let lines=formations[teams[team].formation],spots=[{x:team?100:5,y:34,role:'GK'}];let depth=lines.length;lines.forEach((count,li)=>{let d=15+(li/(Math.max(1,depth-1)))*61;for(let j=0;j<count;j++)spots.push({x:team?105-d:d,y:(j+1)*68/(count+1),role:li===0?'DEF':li===depth-1?'ATT':'MID'})});return spots}
function assignFormation(team,teleport=false){let players=active(team),spots=template(team);players.forEach((p,i)=>{if(!spots[i])return;p.baseX=spots[i].x;p.baseY=spots[i].y;if(teleport){p.x=p.baseX;p.y=p.baseY;p.tx=p.x;p.ty=p.y}})}
function seedMatch(){const r=seeded($('seed').value);sim={rng:r,time:0,score:[0,0],shots:[0,0],sot:[0,0],xg:[0,0],poss:[0,0],pass:[0,0],turn:[0,0],events:0,log:[],ball:{x:52.5,y:34},carrier:null,owner:0,nextAction:0.4,finished:false};teams.forEach((t,i)=>{t.subCount=0;t.players.forEach(p=>p.fitness=1);assignFormation(i,true)});kickoff(0,false);playing=false;$('start').textContent='▶ Play';accum=0;resetVisuals();updateAll()}
function kickoff(t,announce=true){let ps=active(t),mid=ps.filter(p=>p.role!=='GK').sort((a,b)=>Math.abs(a.baseX-52.5)-Math.abs(b.baseX-52.5))[0];sim.owner=t;sim.carrier=mid;mid.x=52.5;mid.y=34;sim.ball.x=52.5;sim.ball.y=34;sim.nextAction=.7;if(announce)event('Kick-off · '+(t?'Orange':'Blue')+' XI', 'neutral')}
function event(s,type='neutral'){if(!sim)return;sim.log.unshift({time:sim.time,s,type});sim.log=sim.log.slice(0,100);renderLog()}
function rnd(){return sim.rng()};function nearestOpp(p){let op=active(1-p.team);return op.reduce((best,q)=>dist(p,q)<dist(p,best)?q:best,op[0])}
function targetFor(p){let t=teams[p.team],attack=p.team? -1:1,bx=p.baseX,by=p.baseY,has=sim.owner===p.team,ball=sim.ball;let x=bx,y=by;if(p.role==='GK'){x=clamp(bx+(has?attack*3:0),2,103);y=clamp(34+(ball.y-34)*.22,22,46)}else if(has){let push=t.mentality==='attacking'?8:t.mentality==='defensive'?-4:3;x=clamp(bx+attack*(push+(ball.x-52.5)*attack*.19),8,97);y=clamp(by+(ball.y-by)*.21,3,65);if(p===sim.carrier){x=p.x;y=p.y}}else{let push=t.press==='high'?11:t.press==='low'?-5:3;x=clamp(bx+attack*(push+(ball.x-52.5)*attack*.25),6,99);y=clamp(by+(ball.y-by)*.3,3,65);let d=dist(p,ball);if(d<17&&p.role!=='GK'){x=clamp(x+(ball.x-x)*.34,4,101);y=clamp(y+(ball.y-y)*.34,2,66)}}return{x,y}}
function movePlayers(dt){for(let t=0;t<2;t++)for(let p of active(t)){let tar=targetFor(p),d=dist(p,tar),v=(2.3+p.pace/99*3.4)*(0.42+0.58*p.fitness);if(p.role==='GK')v*=.8;if(d>.03){let step=Math.min(d,v*dt);p.x+=(tar.x-p.x)/d*step;p.y+=(tar.y-p.y)/d*step}p.fitness=clamp(p.fitness-dt*(.000022+((teams[t].press==='high'?.000014:0))*(.75+p.stamina/150*-0.4)),.48,1)}if(sim.carrier){sim.ball.x=sim.carrier.x;sim.ball.y=sim.carrier.y}}
function skill(p,keys0){return avg(keys0.map(k=>p[k]))*(.55+.45*p.fitness)}
function chooseAction(){sim.events++;let p=sim.carrier;if(!p){kickoff(0);return}const team=p.team,dir=team?-1:1,goal={x:team?0:105,y:34},opp=nearestOpp(p),pressure=dist(p,opp),goalD=dist(p,goal),t=teams[team],teammates=active(team).filter(q=>q!==p&&q.role!=='GK');let shoot=goalD<33&&(goalD<20||rnd()<.32)&&Math.abs(p.y-34)<26;if(shoot){shot(p,goalD,pressure);return}
let choices=teammates.map(q=>{let d=dist(p,q),advance=(q.x-p.x)*dir,op=active(1-team),lane=Math.min(...op.map(e=>{const dx=q.x-p.x,dy=q.y-p.y,tt=clamp(((e.x-p.x)*dx+(e.y-p.y)*dy)/(dx*dx+dy*dy+.01),0,1);return Math.hypot(e.x-(p.x+tt*dx),e.y-(p.y+tt*dy))}));let merit=2+advance*(t.style==='direct'?.13:.06)-Math.abs(d-16)*.12+Math.min(12,lane)*.5+(t.style==='possession'?-Math.max(0,d-22)*.6:0)+(t.style==='counter'&&advance>5?3:0)+rnd()*9;return{q,d,lane,merit}}).sort((a,b)=>b.merit-a.merit);let dribble=pressure>3.1&&goalD>14&&p.role!=='GK'&&rnd()<(t.style==='direct'?.18:.29);if(dribble){let n=nearestOpp(p),success=clamp(.61+(skill(p,['dribbling','touch','pace'])-skill(n,['tackling','positioning']))*.006+(pressure-6)*.025,.12,.91);if(rnd()<success){p.x=clamp(p.x+dir*(3+rnd()*5),1,104);p.y=clamp(p.y+(rnd()-.5)*7,1,67);sim.ball.x=p.x;sim.ball.y=p.y;if(rnd()<.15)event(p.name+' beats a defender');}else takeover(n,true);sim.nextAction=.55+rnd()*.6;return}
let c=choices[0];if(!c){sim.nextAction=1;return}let chance=clamp(.79+(skill(p,['passing','vision','decisions'])-75)*.004+(skill(c.q,['touch','positioning'])-70)*.0017-c.d*.0046+Math.min(9,c.lane)*.012-(pressure<4?.11:0),.08,.97);if(rnd()<chance){sim.pass[team]++;sim.carrier=c.q;sim.owner=team;ballFx={a:{x:visualBall.x,y:visualBall.y},b:{x:c.q.x,y:c.q.y},at:performance.now(),duration:clamp(240+c.d*9,260,700)/Math.sqrt(Number($('speed').value)||1)};if(rnd()<.04&&c.d>19)event(p.name+' finds '+c.q.name+' with a long pass');}else{let intended=c.q;let q=active(1-team).reduce((best,opp)=>dist(opp,intended)<dist(best,intended)?opp:best,active(1-team)[0]);takeover(q,true)}sim.nextAction=clamp(.45+c.d*.024+rnd()*.3,.4,1.7)}
function takeover(q,turn){let old=sim.owner;sim.owner=q.team;sim.carrier=q;sim.ball.x=q.x;sim.ball.y=q.y;if(turn)sim.turn[old]++;sim.nextAction=.45+rnd()*.55}
function shot(p,d,pressure){let t=p.team,angle=Math.abs(p.y-34),xg=clamp(.42*Math.exp(-d/17)*Math.max(.24,1-angle/44)*(pressure<3?.63:1),.012,.43),on=clamp(.42+(skill(p,['finishing','composure'])-70)*.006-(d-14)*.008-angle*.005,.16,.78);sim.shots[t]++;sim.xg[t]+=xg;let onTarget=rnd()<on;if(onTarget)sim.sot[t]++;let keeper=active(1-t).find(q=>q.role==='GK'),stop=clamp(.32+(keeper?keeper.goalkeeping-70:0)*.006+(d-13)*.005,.18,.78),goal=onTarget&&rnd()<clamp(xg/Math.max(.12,on)*(1-stop*.32),.015,.83);if(goal){sim.score[t]++;event('GOAL! '+p.name+' scores for '+(t?'Orange':'Blue')+' XI ('+sim.score[0]+'–'+sim.score[1]+')','goal');kickoff(1-t,false)}else{event(p.name+' shoots · '+(!onTarget?'off target':'saved by goalkeeper'));let q=keeper||active(1-t)[0];takeover(q,false)}sim.nextAction=1.1+rnd()*.8}
function advance(dt){if(!sim||sim.finished)return;let remaining=dt;while(remaining>0&&!sim.finished){let step=Math.min(STEP,remaining,Math.max(.001,sim.nextAction));sim.time+=step;remaining-=step;if(sim.owner!==null)sim.poss[sim.owner]+=step;movePlayers(step);sim.nextAction-=step;if(sim.nextAction<=.00001)chooseAction();if(sim.time>=5400){sim.time=5400;sim.finished=true;playing=false;$('start').textContent='▶ Play';event('Full time · '+sim.score.join('–'),'goal')}else if(sim.time>=2700&&!sim.halftime){sim.halftime=true;event('Half-time · second-half play begins');}}
}
function draw(){const c=$('pitch'),ctx=c.getContext('2d'),sx=c.width/W,sy=c.height/L;ctx.clearRect(0,0,c.width,c.height);ctx.fillStyle='#126444';ctx.fillRect(0,0,c.width,c.height);for(let i=0;i<10;i++){ctx.fillStyle=i%2?'#116040':'#176b4a';ctx.fillRect(i*c.width/10,0,c.width/10,c.height)}ctx.save();ctx.scale(sx,sy);ctx.strokeStyle='rgba(245,255,250,.72)';ctx.lineWidth=.19;ctx.strokeRect(.5,.5,104,67);ctx.beginPath();ctx.moveTo(52.5,.5);ctx.lineTo(52.5,67.5);ctx.stroke();ctx.beginPath();ctx.arc(52.5,34,9.15,0,Math.PI*2);ctx.stroke();ctx.strokeRect(.5,13.84,16.5,40.32);ctx.strokeRect(88,13.84,16.5,40.32);ctx.strokeRect(.5,24.84,5.5,18.32);ctx.strokeRect(99,24.84,5.5,18.32);ctx.strokeRect(-1.5,30.34,2,7.32);ctx.strokeRect(104.5,30.34,2,7.32);ctx.fillStyle='#d9eadf';ctx.beginPath();ctx.arc(11.5,34,.45,0,7);ctx.arc(93.5,34,.45,0,7);ctx.fill();for(let t=0;t<2;t++)for(let p of active(t)){let v=visualPlayers.get(p.id),x=v?.x??p.x,y=v?.y??p.y;ctx.beginPath();ctx.arc(x,y,1.55,0,7);ctx.fillStyle=t?'#ee9a4d':'#299ad9';ctx.fill();ctx.lineWidth=.26;ctx.strokeStyle='#e8f5ff';ctx.stroke();ctx.font='bold 1.6px Arial';ctx.fillStyle='#fff';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(p.num,x,y+.12);if(sim?.carrier===p){ctx.beginPath();ctx.strokeStyle='#fffab6';ctx.lineWidth=.35;ctx.arc(x,y,2.3,0,7);ctx.stroke()}}ctx.restore();if(sim){
    // Draw the football in screen-space, rather than pitch metres, for a crisp icon.
    const bx=visualBall.x*sx,by=visualBall.y*sy,r=6.6;
    ctx.save();ctx.fillStyle='rgba(0,0,0,.26)';ctx.beginPath();ctx.ellipse(bx+1.7,by+3,r*.95,r*.55,0,0,Math.PI*2);ctx.fill();
    ctx.beginPath();ctx.arc(bx,by,r,0,Math.PI*2);ctx.fillStyle='#fff';ctx.fill();ctx.lineWidth=1.2;ctx.strokeStyle='#1c2630';ctx.stroke();
    ctx.beginPath();for(let i=0;i<5;i++){const theta=-Math.PI/2+i*2*Math.PI/5;const x=bx+Math.cos(theta)*3.15,y=by+Math.sin(theta)*3.15;if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y)}ctx.closePath();ctx.fillStyle='#1c2630';ctx.fill();
    ctx.restore();}}

function renderLog(){if(!sim)return;$('log').innerHTML=sim.log.map(e=>'<div class="event '+e.type+'"><b>'+fmt(e.time)+'</b> · '+esc(e.s)+'</div>').join('')||'<div class="event">Ready for kick-off. Configure your teams, then press Play.</div>'}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function fmt(s){let m=Math.floor(s/60);return String(m).padStart(2,'0')+':'+String(Math.floor(s%60)).padStart(2,'0')}
function updateAll(){if(!sim)return;$('score').textContent=sim.score.join(' : ');$('clock').textContent=fmt(sim.time)+' · '+(sim.finished?'FULL TIME':sim.time>=2700?'SECOND HALF':'FIRST HALF');$('poss').textContent=(100*sim.poss[0]/Math.max(1,sim.time)).toFixed(0)+'% : '+(100*sim.poss[1]/Math.max(1,sim.time)).toFixed(0)+'%';$('shots').textContent=sim.shots.join(' : ');$('sot').textContent=sim.sot.join(' : ');$('xg').textContent=sim.xg.map(v=>v.toFixed(2)).join(' : ');$('passes').textContent=sim.pass.join(' : ');$('turnovers').textContent=sim.turn.join(' : ');$('events').textContent=sim.events;$('phase').textContent=sim.finished?'Full time':sim.time>=2700?'Second half':'First half';$('carrier').textContent=sim.carrier?.name||'—';$('owner').textContent=sim.owner?'Orange XI':'Blue XI';$('fitness').textContent=[0,1].map(t=>Math.round(100*avg(active(t).map(p=>p.fitness)))+'%').join(' : ');$('homeFormation').textContent=teams[0].formation;$('awayFormation').textContent=teams[1].formation;$('subsUsed').textContent=teams[selectedTeam].subCount+'/5 used';$('subBtn').disabled=teams[selectedTeam].subCount>=5||sim.finished;draw()}
function selectTeam(t){selectedTeam=t;$('team0').classList.toggle('chosen',t===0);$('team1').classList.toggle('chosen',t===1);$('formation').value=teams[t].formation;$('style').value=teams[t].style;$('press').value=teams[t].press;$('mentality').value=teams[t].mentality;selectedId=teams[t].players.find(p=>p.active).id;renderSquad();renderPlayer();renderSubs();updateAll()}
function renderSquad(){let ps=teams[selectedTeam].players;$('squad').innerHTML=ps.map(p=>'<div class="player '+(selectedId===p.id?'active':'')+'" data-id="'+p.id+'"><span class="num">'+p.num+'</span><span>'+esc(p.name)+'<div class="role">'+p.role+' · '+(p.active?'STARTING':'SUB')+' · '+Math.round(p.fitness*100)+'% fitness</div></span><span class="rating">'+overall(p)+'</span></div>').join('');$('squad').querySelectorAll('.player').forEach(el=>el.onclick=()=>{selectedId=+el.dataset.id;renderSquad();renderPlayer()})}
function renderSubs(){let ps=teams[selectedTeam].players;$('outPlayer').innerHTML=ps.filter(p=>p.active).map(p=>'<option value="'+p.id+'">'+esc(p.name)+'</option>').join('');$('inPlayer').innerHTML=ps.filter(p=>!p.active).map(p=>'<option value="'+p.id+'">'+esc(p.name)+'</option>').join('')}
function renderPlayer(){let p=teams[selectedTeam].players.find(p=>p.id===selectedId);if(!p)return;$('playerName').textContent=p.name+' · #'+p.num;$('playerInfo').textContent=p.role+' · '+(p.active?'Starting XI':'Substitute')+' · Overall '+overall(p);$('attributes').innerHTML=keys.map((k,i)=>'<div class="field"><div class="between"><label>'+attrNames[i]+'</label><b id="v_'+k+'">'+p[k]+'</b></div><input type="range" data-attr="'+k+'" min="1" max="99" value="'+p[k]+'"></div>').join('');$('attributes').querySelectorAll('[data-attr]').forEach(el=>el.oninput=()=>{p[el.dataset.attr]=+el.value;$('v_'+el.dataset.attr).textContent=el.value;$('playerInfo').textContent=p.role+' · '+(p.active?'Starting XI':'Substitute')+' · Overall '+overall(p);renderSquad()})}
function substitute(){if(!sim||sim.finished||teams[selectedTeam].subCount>=5)return;let ps=teams[selectedTeam].players,a=ps.find(p=>p.id===+$('outPlayer').value),b=ps.find(p=>p.id===+$('inPlayer').value);if(!a||!b||!a.active||b.active)return;a.active=false;b.active=true;b.fitness=1;teams[selectedTeam].subCount++;if(sim.carrier===a){sim.carrier=b;sim.owner=b.team}assignFormation(selectedTeam,true);event((selectedTeam?'Orange':'Blue')+' substitution · '+b.name+' for '+a.name);renderSquad();renderSubs();updateAll()}
function runBatch(N){let saveSim=sim,savePlaying=playing,saveTeams=teams;playing=false;let results=[0,0,0],gf=[0,0],shots=[0,0],pos=[0,0],totalXg=[0,0];let roster=teams.map(t=>({...t,players:t.players.map(p=>({...p}))}));for(let i=0;i<N;i++){teams=roster.map(t=>({...t,players:t.players.map(p=>({...p}))}));let rand=seeded((Number($('seed').value)+i*7919)>>>0);sim={rng:rand,time:0,score:[0,0],shots:[0,0],sot:[0,0],xg:[0,0],poss:[0,0],pass:[0,0],turn:[0,0],events:0,log:[],ball:{x:52.5,y:34},carrier:null,owner:0,nextAction:0.4,finished:false};teams.forEach((t,j)=>{t.players.forEach(p=>p.fitness=1);assignFormation(j,true)});kickoff(i%2,false);advance(5400);gf[0]+=sim.score[0];gf[1]+=sim.score[1];shots[0]+=sim.shots[0];shots[1]+=sim.shots[1];totalXg[0]+=sim.xg[0];totalXg[1]+=sim.xg[1];pos[0]+=sim.poss[0];pos[1]+=sim.poss[1];results[sim.score[0]>sim.score[1]?0:sim.score[0]===sim.score[1]?1:2]++}teams=saveTeams;sim=saveSim;playing=savePlaying;renderLog();updateAll();let row=(n,a,b)=>'<div class="testrow">'+n+'<div><b>'+a+' : '+b+'</b></div></div>';$('batchResults').innerHTML='<div class="testrow"><b>'+N+' simulations completed</b></div>'+'<div class="testrow">Home wins / Draws / Away wins<div><b>'+results.join(' / ')+'</b></div></div>'+row('Mean goals per match',(gf[0]/N).toFixed(2),(gf[1]/N).toFixed(2))+row('Mean shots',(shots[0]/N).toFixed(1),(shots[1]/N).toFixed(1))+row('Mean expected goals',(totalXg[0]/N).toFixed(2),(totalXg[1]/N).toFixed(2))+row('Average possession',(pos[0]/(54*N)).toFixed(1)+'%',(pos[1]/(54*N)).toFixed(1)+'%');sanityCheck()}
function sanityCheck(){let checks=[['Both teams have 17 registered players',teams.every(t=>t.players.length===17)],['Exactly 11 active players per team',teams.every((t,i)=>active(i).length===11)],['Exactly 6 reserves per team',teams.every(t=>t.players.filter(p=>!p.active).length===6)],['Formation positions total 11',teams.every(t=>1+formations[t.formation].reduce((a,b)=>a+b,0)===11)],['Player attributes stay within 1–99',teams.every(t=>t.players.every(p=>keys.every(k=>p[k]>=1&&p[k]<=99)))],['Current score and statistics nonnegative',sim&&[...sim.score,...sim.shots,...sim.xg].every(v=>v>=0)],['Possession tracked from clock',sim&&Math.abs(sim.poss[0]+sim.poss[1]-sim.time)<.1]];$('sanity').innerHTML=checks.map(([n,pass])=>'<div class="testrow '+(pass?'good':'bad')+'">'+(pass?'✓':'✕')+' '+n+'</div>').join('')}
Object.keys(formations).forEach(f=>$('formation').add(new Option(f,f)));$('team0').onclick=()=>selectTeam(0);$('team1').onclick=()=>selectTeam(1);$('formation').onchange=e=>{teams[selectedTeam].formation=e.target.value;assignFormation(selectedTeam,false);updateAll();sanityCheck()};['style','press','mentality'].forEach(k=>$(k).onchange=e=>teams[selectedTeam][k]=e.target.value);$('subBtn').onclick=substitute;$('randomize').onclick=()=>{let p=teams[selectedTeam].players.find(p=>p.id===selectedId),r=seeded((Date.now()>>>0)^p.id);keys.forEach(k=>p[k]=Math.round(35+60*r()));renderPlayer();renderSquad()};$('tabPlayer').onclick=()=>{$('editor').classList.remove('hidden');$('testsPanel').classList.add('hidden');$('tabPlayer').classList.add('sel');$('tabTests').classList.remove('sel')};$('tabTests').onclick=()=>{$('editor').classList.add('hidden');$('testsPanel').classList.remove('hidden');$('tabPlayer').classList.remove('sel');$('tabTests').classList.add('sel');sanityCheck()};$('batchRun').onclick=()=>{playing=false;$('start').textContent='▶ Play';runBatch(+$('batchCount').value)};$('start').onclick=()=>{if(sim.finished)seedMatch();playing=!playing;$('start').textContent=playing?'Ⅱ Pause':'▶ Play'};$('step').onclick=()=>{playing=false;$('start').textContent='▶ Play';advance(10);updateAll();renderSquad()};$('reset').onclick=()=>{seedMatch();renderSquad();renderSubs();sanityCheck()};$('seed').onchange=()=>{seedMatch();renderSquad()};
function animation(now){let elapsed=Math.min(.08,(now-lastFrame)/1000);lastFrame=now;if(playing){accum+=elapsed*Number($('speed').value);let iterations=0;while(accum>=STEP&&iterations<600){advance(STEP);accum-=STEP;iterations++}if(iterations){updateAll();if(Math.floor(sim.time)%10===0)renderSquad()}}smoothVisuals(elapsed);draw();requestAnimationFrame(animation)}seedMatch();selectTeam(0);sanityCheck();requestAnimationFrame(animation);
</script></body></html>
